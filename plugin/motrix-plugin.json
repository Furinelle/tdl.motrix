{
  "manifestVersion": 1,
  "id": "tdl.motrix",
  "name": "%name%",
  "version": "0.1.7",
  "description": "%description%",
  "categories": ["site-resolver"],
  "engines": { "motrix": ">=2.0.0 <3.0.0" },
  "main": "dist/plugin.js",
  "requestedHeapMB": 32,
  "permissions": ["http"],
  "hostPermissions": [
    "http://*/status",
    "http://*/resolve",
    "https://t.me/*",
    "https://t.me/*/*",
    "https://t.me/*/*/*",
    "https://t.me/*/*/*/*",
    "https://telegram.me/*",
    "https://telegram.me/*/*",
    "https://telegram.me/*/*/*",
    "https://telegram.me/*/*/*/*",
    "https://telegram.dog/*",
    "https://telegram.dog/*/*",
    "https://telegram.dog/*/*/*",
    "https://telegram.dog/*/*/*/*"
  ],
  "activationEvents": ["onTaskType:http"],
  "contributes": {
    "hooks": {
      "beforeCreate": { "role": "resolve" }
    }
  },
  "l10n": "locales"
}
